/// Provider-booking compatibility record for a single OrderShipment. Multi-package routing and
/// package tracking are authoritative in CourierConsignment and CourierConsignmentPackage.
model CourierShipment {
  id                      String                 @id @default(uuid()) @db.Uuid
  orderShipmentId         String                 @unique @map("order_shipment_id") @db.Uuid
  orderId                 String                 @map("order_id") @db.Uuid
  sellerId                String                 @map("seller_id") @db.Uuid
  providerCode            String                 @map("provider_code")
  providerOrderId         String?                @map("provider_order_id")
  awbNumber               String?                @unique @map("awb_number")
  trackingStatus          CourierShipmentStatus  @default(NOT_BOOKED) @map("tracking_status")
  trackingStatusLabel     String?                @map("tracking_status_label")
  trackingUrl             String?                @map("tracking_url")
  labelUrl                String?                @map("label_url")
  bookingPayloadSnapshot  Json?                  @map("booking_payload_snapshot")
  bookingResponseSnapshot Json?                  @map("booking_response_snapshot")
  lastWebhookEventId      String?                @map("last_webhook_event_id")
  lastWebhookAt           DateTime?              @map("last_webhook_at")
  lastTrackedAt           DateTime?              @map("last_tracked_at")
  bookingAttemptCount     Int                    @default(0) @map("booking_attempt_count")
  bookingError            String?                @map("booking_error")
  bookedAt                DateTime?              @map("booked_at")
  cancelledAt             DateTime?              @map("cancelled_at")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")
  orderShipment           OrderShipment          @relation(fields: [orderShipmentId], references: [id], onDelete: Cascade)
  order                   Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller                  Seller                 @relation(fields: [sellerId], references: [id])
  provider                CourierProviderSetting @relation(fields: [providerCode], references: [providerCode])
  codRemittance           CourierCodRemittance?

  @@unique([providerCode, providerOrderId])
  @@index([orderId, trackingStatus, updatedAt])
  @@index([sellerId, trackingStatus, updatedAt])
  @@index([providerCode, trackingStatus, updatedAt])
  @@index([providerCode, lastTrackedAt])
  @@map("courier_shipments")
}

/// Canonical provider consignment for an OrderShipment. A shipment may have multiple consignments
/// across retries or package groups; current OrderShipment status is the customer-facing rollup.
model CourierConsignment {
  id                      String                      @id @default(uuid()) @db.Uuid
  consignmentNumber       String                      @unique @map("consignment_number")
  orderShipmentId         String                      @map("order_shipment_id") @db.Uuid
  orderId                 String                      @map("order_id") @db.Uuid
  sellerId                String                      @map("seller_id") @db.Uuid
  providerCode            String                      @map("provider_code")
  providerOrderId         String?                     @map("provider_order_id")
  pickupLocationName      String?                     @map("pickup_location_name")
  trackingStatus          CourierShipmentStatus       @default(NOT_BOOKED) @map("tracking_status")
  trackingStatusLabel     String?                     @map("tracking_status_label")
  manifestUrl             String?                     @map("manifest_url")
  invoiceUrl              String?                     @map("invoice_url")
  labelDocumentUrl        String?                     @map("label_document_url")
  shippingZone            String?                     @map("shipping_zone")
  providerRawStatus       String?                     @map("provider_raw_status")
  providerRawStatusCode   String?                     @map("provider_raw_status_code")
  bookingPayloadSnapshot  Json?                       @map("booking_payload_snapshot")
  bookingResponseSnapshot Json?                       @map("booking_response_snapshot")
  lastWebhookEventId      String?                     @map("last_webhook_event_id")
  lastWebhookAt           DateTime?                   @map("last_webhook_at")
  lastTrackedAt           DateTime?                   @map("last_tracked_at")
  bookingAttemptCount     Int                         @default(0) @map("booking_attempt_count")
  bookingError            String?                     @map("booking_error")
  bookedAt                DateTime?                   @map("booked_at")
  cancelledAt             DateTime?                   @map("cancelled_at")
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")
  orderShipment           OrderShipment               @relation(fields: [orderShipmentId], references: [id], onDelete: Cascade)
  order                   Order                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller                  Seller                      @relation(fields: [sellerId], references: [id])
  provider                CourierProviderSetting      @relation(fields: [providerCode], references: [providerCode])
  packages                CourierConsignmentPackage[]

  @@unique([providerCode, providerOrderId])
  @@index([orderId, trackingStatus, updatedAt])
  @@index([orderShipmentId, trackingStatus, updatedAt])
  @@index([sellerId, trackingStatus, updatedAt])
  @@index([providerCode, trackingStatus, updatedAt])
  @@index([providerCode, lastTrackedAt])
