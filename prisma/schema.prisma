  requestedB2BOrderAmendments              B2BOrderAmendment[]               @relation("B2BOrderAmendmentRequestedBy")
  decidedB2BOrderAmendments                B2BOrderAmendment[]               @relation("B2BOrderAmendmentDecidedBy")
  resolvedB2BDisputes                      B2BDisputeResolution[]             @relation("B2BDisputeResolutionResolvedBy")
