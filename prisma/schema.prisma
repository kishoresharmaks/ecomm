  issueDate             DateTime               @map("issue_date")
  supplierLegalName     String                 @map("supplier_legal_name")
  supplierGstin         String                 @map("supplier_gstin")
  supplierAddressSnapshot Json                 @map("supplier_address_snapshot")
  recipientLegalName    String                 @map("recipient_legal_name")
  recipientGstin        String?                @map("recipient_gstin")
  recipientAddressSnapshot Json                @map("recipient_address_snapshot")
  placeOfSupplyStateCode String?               @map("place_of_supply_state_code")
  supplyType            TaxSupplyType?
  currency              String                 @default("INR")
  taxableValuePaise     Int                    @default(0) @map("taxable_value_paise")
  cgstPaise             Int                    @default(0) @map("cgst_paise")
  sgstPaise             Int                    @default(0) @map("sgst_paise")
  igstPaise             Int                    @default(0) @map("igst_paise")
  cessPaise             Int                    @default(0) @map("cess_paise")
  totalTaxPaise         Int                    @default(0) @map("total_tax_paise")
  invoiceValuePaise     Int                    @default(0) @map("invoice_value_paise")
