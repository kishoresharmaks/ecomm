  reviewedB2BCreditProfiles                BusinessBuyerCreditProfile[]       @relation("B2BCreditProfileReviewedBy")
  decidedB2BCreditDecisions                B2BCreditDecision[]                @relation("B2BCreditDecisionDecidedBy")
  assignedB2BWarehouseTasks                B2BWarehouseTask[]                 @relation("B2BWarehouseTaskAssignedTo")
  inspectedB2BQcInspections                B2BQcInspection[]                  @relation("B2BQcInspectionInspectedBy")
