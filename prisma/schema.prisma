  subscriptionCurrentPeriodEnd DateTime?                      @map("subscription_current_period_end")
  createdAt                    DateTime                       @default(now()) @map("created_at")
  updatedAt                    DateTime                       @updatedAt @map("updated_at")
  deletedAt                    DateTime?                      @map("deleted_at")
  user                         User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionPlan             SellerSubscriptionPlan?        @relation("SellerCurrentSubscriptionPlan", fields: [subscriptionPlanId], references: [id])
  subscriptions                SellerSubscription[]
  subscriptionPayments         SellerSubscriptionPayment[]
  profile                      SellerProfile?
  addresses                    SellerAddress[]
  serviceAreas                 SellerServiceArea[]
  serviceTechnicians           SellerServiceTechnician[]
  serviceAvailabilityRules     SellerServiceAvailabilityRule[]
  serviceBlockedWindows        SellerServiceBlockedWindow[]
  documents                    SellerDocument[]
  products                     Product[]
  serviceListings              ServiceListing[]
  serviceBookings              ServiceBooking[]
  servicePayments              ServicePayment[]
  serviceSettlements           ServiceBookingSettlement[]
  serviceReceivables           ServiceSellerReceivable[]
  sellerCashReceivables        SellerCashReceivable[]
  serviceRefundRequests        ServiceRefundRequest[]
  serviceReviews               ServiceReview[]
  cartItems                    CartItem[]
  orderItems                   OrderItem[]
  orderSplits                  OrderSellerSplit[]
  orderShipments               OrderShipment[]
  orderShipmentPackages        OrderShipmentPackage[]
  courierConsignments          CourierConsignment[]
  courierConsignmentPackages   CourierConsignmentPackage[]
  courierShipments             CourierShipment[]
  courierCodRemittances        CourierCodRemittance[]
  courierProviderSettings      SellerCourierProviderSetting[]
  b2bEnquiries                 B2BEnquiry[]
  b2bOrders                    B2BOrder[]
  commissionRules              CommissionRule[]
  payoutProfile                SellerPayoutProfile?
  ledgerEntries                SellerLedgerEntry[]
  payouts                      SellerPayout[]
  statements                   SellerStatement[]
  dealParticipations           DealParticipation[]
  dealProductEnrollments       DealProductEnrollment[]
  couponEligibilities          CouponSellerEligibility[]
  couponParticipations         CouponSellerParticipation[]
  productReviews               ProductReview[]
  returnItems                  ReturnRequestItem[]
