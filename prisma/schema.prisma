  createdB2BProofsOfDelivery               B2BProofOfDelivery[]               @relation("B2BProofOfDeliveryCreatedBy")
  assignedB2BShipments                     B2BShipment[]                      @relation("B2BShipmentAssignedDeliveryUser")
  verifiedB2BPaymentRecords                B2BPaymentRecord[]                 @relation("B2BPaymentRecordVerifiedBy")
  issuedB2BReceiptVouchers                 B2BReceiptVoucher[]                @relation("B2BReceiptVoucherIssuedBy")
  assignedB2BCollectionTasks               B2BCollectionTask[]               @relation("B2BCollectionTaskAssignedTo")
  createdB2BSupportCases                   B2BSupportCase[]                   @relation("B2BSupportCaseCreatedBy")
