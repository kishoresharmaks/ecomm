model DeliveryDetail {
  id                      String                        @id @default(uuid()) @db.Uuid
  orderId                 String                        @unique @map("order_id") @db.Uuid
  deliveryMode            DeliveryMode                  @map("delivery_mode")
  partnerName             String?                       @map("partner_name")
  partnerPhone            String?                       @map("partner_phone")
  deliveryPartnerUserId   String?                       @map("delivery_partner_user_id") @db.Uuid
  courierProviderCode     String?                       @map("courier_provider_code")
  routingFailed           Boolean                       @default(false) @map("routing_failed")
  routingFailureReason    DeliveryRoutingFailureReason? @map("routing_failure_reason")
  routingFailureNote      String?                       @map("routing_failure_note")
  routedAt                DateTime?                     @map("routed_at")
  assignmentStatus        DeliveryAssignmentStatus      @default(UNASSIGNED) @map("assignment_status")
  assignedAt              DateTime?                     @map("assigned_at")
  acceptedAt              DateTime?                     @map("accepted_at")
  rejectedAt              DateTime?                     @map("rejected_at")
  assignmentExpiresAt     DateTime?                     @map("assignment_expires_at")
  assignmentNote          String?                       @map("assignment_note")
  shippingChargeSnapshot  Json?                         @map("shipping_charge_snapshot")
  codSurchargeSnapshot    Json?                         @map("cod_surcharge_snapshot")
  awbNumber               String?                       @unique @map("awb_number")
  courierTrackingStatus   CourierShipmentStatus         @default(NOT_BOOKED) @map("courier_tracking_status")
  labelUrl                String?                       @map("label_url")
  trackingReference       String?                       @unique @map("tracking_reference")
  estimatedDeliveryDate   DateTime?                     @map("estimated_delivery_date")
  deliveryNote            String?                       @map("delivery_note")
  receiverName            String?                       @map("receiver_name")
  proofNote               String?                       @map("proof_note")
  proofReference          String?                       @map("proof_reference")
  status                  DeliveryStatus                @default(PENDING)
  codCollectionStatus     CodCollectionStatus           @default(NOT_COLLECTED) @map("cod_collection_status")
  codCollectionSource     CodCollectionSource?          @map("cod_collection_source")
  codCollectedAmountPaise Int?                          @map("cod_collected_amount_paise")
  codCollectedAt          DateTime?                     @map("cod_collected_at")
  codCollectedById        String?                       @map("cod_collected_by_id") @db.Uuid
  codCollectionNote       String?                       @map("cod_collection_note")
  codVerifiedAt           DateTime?                     @map("cod_verified_at")
  codVerifiedById         String?                       @map("cod_verified_by_id") @db.Uuid
  codVerificationNote     String?                       @map("cod_verification_note")
  createdAt               DateTime                      @default(now()) @map("created_at")
  updatedAt               DateTime                      @updatedAt @map("updated_at")
  order                   Order                         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryPartner         User?                         @relation("DeliveryPartnerAssignments", fields: [deliveryPartnerUserId], references: [id])
  codCollectedBy          User?                         @relation("DeliveryCodCollectedBy", fields: [codCollectedById], references: [id])
  codVerifiedBy           User?                         @relation("DeliveryCodVerifiedBy", fields: [codVerifiedById], references: [id])
  events                  DeliveryEvent[]
  attempts                DeliveryAttempt[]
  assignmentAttempts      DeliveryAssignmentAttempt[]
  walletEntries           DeliveryPartnerWalletEntry[]

  @@index([status, updatedAt])
  @@index([deliveryMode, status])
  @@index([deliveryPartnerUserId, assignmentStatus, status])
  @@index([deliveryPartnerUserId, codCollectionStatus, codCollectedById])
  @@index([courierProviderCode, courierTrackingStatus])
  @@index([routingFailed, createdAt])
  @@index([assignmentStatus, status])
  @@index([assignmentExpiresAt, assignmentStatus])
  @@index([codCollectionStatus, codCollectedById])
  @@index([codCollectionStatus, codVerifiedById])
  @@map("delivery_details")
  @@index([codCollectedById])
  @@index([codVerifiedById])
}

