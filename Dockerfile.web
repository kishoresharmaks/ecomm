FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.20.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages/ ./packages/
COPY apps/web/package.json ./apps/web/
COPY scripts/ ./scripts/
RUN pnpm install --frozen-lockfile

COPY . .
ARG NEXT_PUBLIC_API_URL=https://api.1handindia.com
ARG NEXT_PUBLIC_WEB_URL=https://1handindia.com
ARG NEXT_PUBLIC_APP_ENV=production
ARG NEXT_PUBLIC_API_TIMEOUT_MS=30000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WEB_URL=$NEXT_PUBLIC_WEB_URL
ENV NEXT_PUBLIC_APP_ENV=$NEXT_PUBLIC_APP_ENV
ENV NEXT_PUBLIC_API_TIMEOUT_MS=$NEXT_PUBLIC_API_TIMEOUT_MS
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV PORT=3002
RUN pnpm turbo run build --filter=@indihub/web

EXPOSE 3002
CMD ["pnpm", "--filter", "@indihub/web", "exec", "next", "start", "--port", "3002"]
