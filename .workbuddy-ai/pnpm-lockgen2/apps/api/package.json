{
  "name": "@indihub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node --max-old-space-size=12288 -e \"require('typescript/lib/tsc')\" && node ../../scripts/build-node-service.mjs src/main.ts dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "node --max-old-space-size=12288 -e \"require('typescript/lib/tsc')\"",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "openapi:contract": "tsx --tsconfig tsconfig.json src/app/openapi-contract-cli.ts"
  },
  "dependencies": {
    "@clerk/backend": "3.4.13",
    "@indihub/config": "workspace:*",
    "@indihub/database": "workspace:*",
    "@indihub/shared-types": "workspace:*",
    "@indihub/validators": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/websockets": "11.1.28",
    "bullmq": "5.77.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "^8.2.0",
    "ioredis": "5.10.1",
    "libphonenumber-js": "^1.13.7",
    "nodemailer": "9.0.3",
    "pdfkit": "0.19.1",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "^4.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@indihub/eslint-config": "workspace:*",
    "@indihub/tsconfig": "workspace:*",
    "@nestjs/testing": "11.1.28",
    "@types/express": "^5.0.6",
    "@types/node": "25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "0.17.6",
    "supertest": "7.2.2",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  }
}
